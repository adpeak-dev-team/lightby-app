{
  "expo": {
    "name": "번개분양",
    "slug": "lightby-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lightbyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lightby.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:lightby.co.kr",
        "applinks:www.lightby.co.kr"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "분양 게시글 작성 및 프로필 사진 설정 시, 사진 보관함에서 이미지를 선택해 게시글이나 프로필에 첨부·업로드하기 위해 사용합니다.",
        "LSApplicationQueriesSchemes": [
          "itms-apps",
          "kakaotalk",
          "kakaopay",
          "kftc-bankpay",
          "ispmobile",
          "cloudpay",
          "payco",
          "paycoapp",
          "com.samsung.spay",
          "shinhan-sr-ansimclick",
          "smshinhanansimclick",
          "kb-acp",
          "mpocket.online.ansimclick",
          "hdcardappcardansimclick",
          "smhyundaiansimclick",
          "lottesmartpay",
          "lotteappcard",
          "nhappcardansimclick",
          "wooripay",
          "wooricard",
          "citispay",
          "citimobileapp",
          "hanawalletmembers",
          "hanaskcardmobileportal",
          "nonghyupcardansimclick",
          "supay"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "lightby.co.kr", "pathPrefix": "/posts" },
            { "scheme": "https", "host": "www.lightby.co.kr", "pathPrefix": "/posts" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "package": "com.lightby.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "89b2edd8a00e96465bb62815518d2c62",
          "kotlinVersion": "2.1.21"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#3b82f6",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withPaymentQueries.js",
      "./plugins/withStripPlayStoreIntentExtras.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29eeacd2-e120-463a-a2e1-7e10f36d0d80"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/29eeacd2-e120-463a-a2e1-7e10f36d0d80",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    }
  }
}