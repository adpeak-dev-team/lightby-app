      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lightby.co.kr",
        "EXPO_PUBLIC_KAKAO_REST_API_KEY": "81dfce2f760c6ddbdc55db21c341419f",
        "EXPO_PUBLIC_KAKAO_REDIRECT_URI": "http://localhost:3000/auth/kakao",
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "89b2edd8a00e96465bb62815518d2c62",
        "EXPO_PUBLIC_KAKAO_JS_KEY": "27e15e4c6bade9a7140b016cbeae1300",
        "EXPO_PUBLIC_IMAGE_PREFIX": "https://storage.googleapis.com/lightby/"
