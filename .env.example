# 이 파일은 "어떤 키가 필요한가" 만 알려주는 문서다. 실제 값은 여기 두지 않는다.
#
# 실제 값은 Google Secret Manager 에 있다: lightby-app-env-dev
#   조회:  gcloud secrets versions access latest --secret=lightby-app-env-dev
#   갱신:  gcloud secrets versions add lightby-app-env-dev --data-file=<수정한파일>
#
# 로컬 실행에는 .env 파일이 필요 없다. gcloud auth application-default login 한 번만 하면
# 실행 시점에 Secret Manager 에서 값을 읽어온다.

# 로컬 개발용 (현재 PC IP)
# EXPO_PUBLIC_API_URL="http://192.168.219.51:4000"

# 배포용 API URL
# EXPO_PUBLIC_API_URL="https://lightbyssx.store"

# production (결제 E2E 테스트 - PayApp 웹훅 수신 가능한 공개 백엔드)
EXPO_PUBLIC_API_URL=

# 카카오 정보
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=

# 이미지 URL 접두사
EXPO_PUBLIC_IMAGE_PREFIX=

APPLE_SHARED_SECRET=
